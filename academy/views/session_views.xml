<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="session_view_form" model="ir.ui.view">
        <field name="name">session.view.form</field>
        <field name="model">academy.session</field>
        <field name="arch" type="xml">
            <form string="Session View">
                <header></header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <h2><field name="session_number"/></h2>
                    <group>
                        <group> <separator string="Session Schedule"/>
                            <field name="course_id"></field>
                            <field name="instructor_id"></field>
                            <label for="date_start" string="Dates"/>
                            <div class="o_row">
                                <field name="date_start" widget="daterange" 
                                       options="{'related_end_date': 'date_end'}"
                                       placeholder="Start Date"/>
                                <i class="fa fa-long-arrow-right mx-2" title="Arrow" role="img" aria-label="Arrow"/>
                                <field name="date_end" widget="daterange" 
                                       options="{'related_start_date': 'date_start'}"
                                       placeholder="End Date"/>
                            </div>
                        </group>
                        <group>
                            <separator string="Other Fields"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="session_view_list" model="ir.ui.view">
        <field name="name">session.view.list</field>
        <field name="model">academy.session</field>
        <field name="arch" type="xml">
            <list string="Session List">
                <field name="name"/>
                <field name="session_number"/>
                <field name="course_id"></field>
                <field name="instructor_id"></field>
            </list>
        </field>
    </record>

    <record id="session_view_search" model="ir.ui.view">
        <field name="name">session.view.search</field>
        <field name="model">academy.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="session_number"/>
                <field name="course_id"></field>
                <field name="instructor_id"></field>
                <searchpanel>
                    <field name="course_id" multi="select" enable_counters="1"></field>
                    <field name="instructor_id"></field>
                </searchpanel>
            </search>
        </field>
    </record>
</odoo>