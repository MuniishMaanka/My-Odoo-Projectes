<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit_academy_sale" model="ir.ui.view">
        <field name="name">product.template.only.form.view.inherit.academy.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="courses" string="Courses" 
                      invisible="type != 'course'"
                      groups="academy.group_academy_admin">
                    <field name="course_ids"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>